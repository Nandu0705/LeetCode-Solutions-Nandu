class Solution {
public:
    string findTheString(vector<vector<int>>& lcp) {
        int n = lcp.size();
        string s(n, 0);
        char c = 'a';
        
        // Step 1: Greedily construct the string
        for (int i = 0; i < n; i++) {
            if (s[i]) continue; // Character already assigned
            
            // If we run out of lowercase English letters, it's impossible
            if (c > 'z') return ""; 
            
            for (int j = i; j < n; j++) {
                if (lcp[i][j] > 0) {
                    // Contradiction: j was already grouped with a different character
                    if (s[j] && s[j] != c) {
                        return ""; 
                    }
                    s[j] = c;
                }
            }
            c++;
        }
        
        // Step 2: Validate the constructed string against the LCP matrix
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                int actual_lcp = 0;
                
                if (s[i] == s[j]) {
                    if (i + 1 < n && j + 1 < n) {
                        // We can safely use the input lcp matrix for the DP state
                        // because we are verifying backwards and already validated i+1, j+1
                        actual_lcp = lcp[i + 1][j + 1] + 1;
                    } else {
                        actual_lcp = 1;
                    }
                }
                
                // If the constructed string's true LCP doesn't match the input, it's invalid
                if (lcp[i][j] != actual_lcp) {
                    return ""; 
                }
            }
        }
        
        return s;
    }
};
