class Solution {
public:
    string generateString(string str1, string str2) {
        int n = str1.size(), m = str2.size();
        int len = n + m - 1;
        string word(len, 'a');
        vector<int> fixed(len, 0); 
        
        // First pass: apply all 'T' constraints
        for (int i = 0; i < n; i++) {
            if (str1[i] == 'T') {
                for (int j = 0; j < m; j++) {
                    if (fixed[i + j] && word[i + j] != str2[j]) {
                        return ""; // conflict
                    }
                    word[i + j] = str2[j];
                    fixed[i + j] = 1;
                }
            }
        }
        
        // Second pass: check all 'F' constraints
        for (int i = 0; i < n; i++) {
            if (str1[i] == 'F') {
                bool differs = false;
                for (int j = 0; j < m; j++) {
                    if (word[i + j] != str2[j]) {
                        differs = true;
                        break;
                    }
                }
                if (!differs) {
                    bool changed = false;
                    for (int j = m - 1; j >= 0; j--) {
                        if (!fixed[i + j]) {
                            word[i + j] = (str2[j] == 'a') ? 'b' : 'a';
                            changed = true;
                            break;
                        }
                    }
                    if (!changed) {
                        return ""; // all positions fixed but window matches str2
                    }
                }
            }
        }
        
        // Final verification
        for (int i = 0; i < n; i++) {
            string sub = word.substr(i, m);
            if (str1[i] == 'T' && sub != str2) return "";
            if (str1[i] == 'F' && sub == str2) return "";
        }
        
        return word;
    }
};
