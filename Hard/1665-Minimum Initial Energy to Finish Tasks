class Solution {
public:
    int minimumEffort(vector<vector<int>>& tasks) {
        // Tasks with higher (minimum - actual) buffer go first
        sort(tasks.begin(), tasks.end(), [](const vector<int>& a, const vector<int>& b) {
            return (a[1] - a[0]) > (b[1] - b[0]);
        });

        int ans = 0;
        int current = 0;

        for (auto& task : tasks) {
            ans = max(ans, current + task[1]);
            current += task[0];
        }

        return ans;
    }
};
