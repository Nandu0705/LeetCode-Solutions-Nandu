class Solution {
public:
    bool hasValidPath(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        // For each street type, which directions does it open to?
        // Directions: 0=right, 1=left, 2=down, 3=up
        // dr, dc for each direction
        vector<int> dr = {0, 0, 1, -1};
        vector<int> dc = {1, -1, 0, 0};

        // Which directions each street type connects to
        // street type 1-6 -> set of directions it opens
        vector<vector<int>> connects = {
            {},          // placeholder for index 0
            {0, 1},      // 1: left <-> right
            {2, 3},      // 2: up <-> down
            {1, 2},      // 3: left <-> down
            {0, 2},      // 4: right <-> down
            {1, 3},      // 5: left <-> up
            {0, 3}       // 6: right <-> up
        };

        // Opposite direction mapping
        // opposite of right(0)=left(1), left(1)=right(0), down(2)=up(3), up(3)=down(2)
        vector<int> opposite = {1, 0, 3, 2};

        // BFS
        vector<vector<bool>> visited(m, vector<bool>(n, false));
        queue<pair<int,int>> q;
        q.push({0, 0});
        visited[0][0] = true;

        while (!q.empty()) {
            auto [r, c] = q.front();
            q.pop();

            // Reached destination
            if (r == m - 1 && c == n - 1) return true;

            int streetType = grid[r][c];

            // Try each direction this street connects to
            for (int dir : connects[streetType]) {
                int nr = r + dr[dir];
                int nc = c + dc[dir];

                // Check bounds
                if (nr < 0 || nr >= m || nc < 0 || nc >= n) continue;
                if (visited[nr][nc]) continue;

                // Check if neighbor connects back in opposite direction
                int neighborType = grid[nr][nc];
                bool connectsBack = false;
                for (int ndir : connects[neighborType]) {
                    if (ndir == opposite[dir]) {
                        connectsBack = true;
                        break;
                    }
                }

                if (connectsBack) {
                    visited[nr][nc] = true;
                    q.push({nr, nc});
                }
            }
        }

        return false; // Never reached (m-1, n-1)
    }
};
