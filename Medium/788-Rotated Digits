class Solution {
public:
    int rotatedDigits(int n) {
        int count = 0;
        for (int i = 1; i <= n; i++) {
            bool valid = true, different = false;
            int num = i;
            while (num > 0) {
                int d = num % 10;
                if (d == 3 || d == 4 || d == 7) { valid = false; break; }
                if (d == 2 || d == 5 || d == 6 || d == 9) different = true;
                num /= 10;
            }
            if (valid && different) count++;
        }
        return count;
    }
};
