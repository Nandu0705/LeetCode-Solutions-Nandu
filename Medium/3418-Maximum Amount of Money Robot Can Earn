class Solution {
public:
    int maximumAmount(vector<vector<int>>& coins) {
        int m = coins.size(), n = coins[0].size();
        
        // dp[i][j][k] = max coins at (i,j) with k neutralizations remaining
        vector<vector<array<int, 3>>> dp(m, vector<array<int, 3>>(n, {INT_MIN, INT_MIN, INT_MIN}));
        
        // Base case: starting cell
        dp[0][0][2] = coins[0][0];
        // If starting cell is negative, we can neutralize it
        if (coins[0][0] < 0) {
            dp[0][0][1] = 0; // used 1 neutralization
            dp[0][0][0] = 0; // used 2 neutralizations (both on this cell - same effect)
        } else {
            dp[0][0][1] = coins[0][0]; // no reason to neutralize positive cell
            dp[0][0][0] = coins[0][0];
        }

        // Fill first row
        for (int j = 1; j < n; j++) {
            for (int k = 0; k <= 2; k++) {
                if (dp[0][j-1][k] == INT_MIN) continue;
                int val = coins[0][j];
                // Option 1: take cell as-is
                dp[0][j][k] = max(dp[0][j][k], dp[0][j-1][k] + val);
                // Option 2: neutralize if negative and have neutralizations left
                if (val < 0 && k > 0) {
                    dp[0][j][k-1] = max(dp[0][j][k-1], dp[0][j-1][k]);
                }
            }
        }

        // Fill first column
        for (int i = 1; i < m; i++) {
            for (int k = 0; k <= 2; k++) {
                if (dp[i-1][0][k] == INT_MIN) continue;
                int val = coins[i][0];
                dp[i][0][k] = max(dp[i][0][k], dp[i-1][0][k] + val);
                if (val < 0 && k > 0) {
                    dp[i][0][k-1] = max(dp[i][0][k-1], dp[i-1][0][k]);
                }
            }
        }

        // Fill rest of grid
        for (int i = 1; i < m; i++) {
            for (int j = 1; j < n; j++) {
                int val = coins[i][j];
                for (int k = 0; k <= 2; k++) {
                    // Coming from top (i-1, j) or left (i, j-1)
                    int best = INT_MIN;
                    if (dp[i-1][j][k] != INT_MIN) best = max(best, dp[i-1][j][k]);
                    if (dp[i][j-1][k] != INT_MIN) best = max(best, dp[i][j-1][k]);
                    
                    if (best == INT_MIN) continue;

                    // Option 1: take as-is
                    dp[i][j][k] = max(dp[i][j][k], best + val);
                    // Option 2: neutralize
                    if (val < 0 && k > 0) {
                        dp[i][j][k-1] = max(dp[i][j][k-1], best);
                    }
                }
            }
        }

        // Answer is max coins at bottom-right with any neutralizations remaining
        return max({dp[m-1][n-1][0], dp[m-1][n-1][1], dp[m-1][n-1][2]});
    }
};
