class Solution {
public:
    int minimumPushes(string word) {
        // Step 1: Count frequency of each letter
        int freq[26] = {0};
        for (char c : word) {
            freq[c - 'a']++;
        }
        
        // Step 2: Sort frequencies in descending order
        // We only need to sort the non-zero frequencies, but sorting all 26 is fine too.
        sort(freq, freq + 26, greater<int>());
        
        int totalPushes = 0;
        
        // Step 3: Assign costs based on rank
        // First 8 letters (indices 0-7) cost 1 push
        // Next 8 letters (indices 8-15) cost 2 pushes
        // Next 8 letters (indices 16-23) cost 3 pushes
        // Remaining letters (indices 24-25) cost 4 pushes
        for (int i = 0; i < 26; ++i) {
            if (freq[i] == 0) break; // No more letters to map
            
            // Determine the cost multiplier based on position
            // (i / 8) gives: 0 for first 8, 1 for next 8, etc.
            // Cost = (i / 8) + 1
            int cost = (i / 8) + 1;
            
            totalPushes += freq[i] * cost;
        }
        
        return totalPushes;
    }
};
