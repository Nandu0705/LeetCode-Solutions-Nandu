class Solution {
public:
    int robotSim(vector<int>& commands, vector<vector<int>>& obstacles) {
        // Direction vectors: North, East, South, West
        int dx[] = {0, 1, 0, -1};
        int dy[] = {1, 0, -1, 0};
        int dir_idx = 0;
        int x = 0, y = 0;
        int max_dist_sq = 0;

        // Store obstacles in a hash set for O(1) lookup
        auto encode = [](int x, int y) {
            return ((long long)(x + 30000)) * 60001 + (y + 30000);
        };

        unordered_set<long long> obstacle_set;
        for (auto& obs : obstacles) {
            obstacle_set.insert(encode(obs[0], obs[1]));
        }

        for (int cmd : commands) {
            if (cmd == -2) {
                dir_idx = (dir_idx - 1 + 4) % 4;  // Turn left
            } else if (cmd == -1) {
                dir_idx = (dir_idx + 1) % 4;       // Turn right
            } else {
                // Move forward one step at a time
                for (int step = 0; step < cmd; step++) {
                    int nx = x + dx[dir_idx];
                    int ny = y + dy[dir_idx];
                    if (obstacle_set.find(encode(nx, ny)) == obstacle_set.end()) {
                        x = nx;
                        y = ny;
                        max_dist_sq = max(max_dist_sq, x*x + y*y);
                    } else {
                        break;  // Blocked by obstacle
                    }
                }
            }
        }

        return max_dist_sq;
    }
};
