class Solution {
public:
    int minJumps(vector<int>& nums) {
        int n = nums.size();
        if (n == 1) return 0;

        // Helper: Sieve / trial division to check primality
        auto isPrime = [](int x) -> bool {
            if (x < 2) return false;
            if (x == 2) return true;
            if (x % 2 == 0) return false;
            for (int i = 3; (long long)i * i <= x; i += 2)
                if (x % i == 0) return false;
            return true;
        };

        // For each prime p, store all indices j where nums[j] % p == 0
        // Key: prime p, Value: list of indices
        unordered_map<int, vector<int>> primeToIndices;

        for (int j = 0; j < n; j++) {
            int val = nums[j];
            // Find all prime factors of nums[j] and register index j under them
            // We only need unique prime factors
            int temp = val;
            for (int f = 2; (long long)f * f <= temp; f++) {
                if (temp % f == 0) {
                    if (isPrime(f)) primeToIndices[f].push_back(j);
                    while (temp % f == 0) temp /= f;
                }
            }
            if (temp > 1 && isPrime(temp)) primeToIndices[temp].push_back(j);
        }

        // BFS
        vector<bool> visited(n, false);
        visited[0] = true;
        queue<int> q;
        q.push(0);
        int jumps = 0;

        while (!q.empty()) {
            int sz = q.size();
            jumps++;

            while (sz--) {
                int i = q.front(); q.pop();

                // 1. Adjacent steps
                for (int ni : {i - 1, i + 1}) {
                    if (ni < 0 || ni >= n) continue;
                    if (ni == n - 1) return jumps;
                    if (!visited[ni]) {
                        visited[ni] = true;
                        q.push(ni);
                    }
                }

                // 2. Prime teleportation: if nums[i] is prime
                int val = nums[i];
                if (isPrime(val)) {
                    auto it = primeToIndices.find(val);
                    if (it != primeToIndices.end()) {
                        for (int j : it->second) {
                            if (j == i) continue;
                            if (j == n - 1) return jumps;
                            if (!visited[j]) {
                                visited[j] = true;
                                q.push(j);
                            }
                        }
                        // Clear to avoid O(n) re-scans for the same prime
                        primeToIndices.erase(it);
                    }
                }
            }
        }

        return -1; // unreachable (won't happen per problem constraints)
    }
};
