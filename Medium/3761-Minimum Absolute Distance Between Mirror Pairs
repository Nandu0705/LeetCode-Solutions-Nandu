class Solution {
public:
    int minMirrorPairDistance(vector<int>& nums) {
        int n = nums.size();
        int ans = -1;
        unordered_map<int, int> lastSeen; // reversed value -> most recent index

        auto reverseNum = [](int x) {
            int rev = 0;
            while (x > 0) {
                rev = rev * 10 + x % 10;
                x /= 10;
            }
            return rev;
        };

        for (int i = 0; i < n; i++) {
            int r = reverseNum(nums[i]);

            // Check if current nums[i] matches a previously stored reverse
            if (lastSeen.count(nums[i])) {
                int dist = i - lastSeen[nums[i]];
                if (ans == -1 || dist < ans) ans = dist;
            }

            // Always update to most recent index for closest future pairs
            lastSeen[r] = i;
        }

        return ans;
    }
};
