class Solution {
public:
    int maxProduct(int n) {
        int fmax=0,smax=0;
        int dig=0;
        while(n>0){
            dig=n%10;
            n=n/10;
            if (dig > fmax) {
                // Shift the old largest to the second largest
                smax = fmax; 
                // Set the new largest
                fmax = dig;  
            } 
            else if (dig > smax) {
                // If it's not the largest, but it IS larger than the second largest
                smax = dig;  
            }
        }
        return (fmax*smax);
    }
};
