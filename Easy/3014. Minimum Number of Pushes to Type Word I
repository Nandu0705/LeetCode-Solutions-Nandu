class Solution {
public:
    int minimumPushes(string word) {
        int n = word.size();
        int sum = 0;
        
        // We have 8 keys.
        // First 8 characters cost 1 push each.
        // Next 8 characters cost 2 pushes each.
        // Next 8 characters cost 3 pushes each.
        // Remaining characters cost 4 pushes each.
        
        // Calculate how many full groups of 8 we have
        int fullGroups = n / 8;
        int remainder = n % 8;
        
        // Sum the cost for full groups
        // Group 1 (1 push) * 8 + Group 2 (2 pushes) * 8 ...
        for (int i = 1; i <= fullGroups; ++i) {
            sum += i * 8;
        }
        
        // Add the cost for the remaining characters (next group)
        sum += (fullGroups + 1) * remainder;
        
        return sum;
    }
};
