vector<int> result;
    for (int i = 0; i < nums.size(); i++) {
        int tempNum = nums[i];
        vector<int> digits;
        
        // Extract digits (right to left)
        while (tempNum > 0) {
            digits.push_back(tempNum % 10);
            tempNum /= 10;
        }
        
        // Add to result in reverse order (left to right)
        for (int j = digits.size() - 1; j >= 0; j--) {
            result.push_back(digits[j]);
        }
    }
    return result;
