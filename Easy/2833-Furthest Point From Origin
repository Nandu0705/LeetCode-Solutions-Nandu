class Solution {
public:
    int furthestDistanceFromOrigin(string moves) {
        int n=moves.size();
        int countl=0;
            int countr=0;
            int count1=0;
            int ans=0;
        for(int i=0;i<n;i++){
            
            if(moves[i]=='L') countl++;
            else if(moves[i]=='R') countr++;
            else count1++;
        }
        if(countl>countr) ans=count1+countl-countr;
        else ans=count1+countr-countl;
        return ans;
    }
};
