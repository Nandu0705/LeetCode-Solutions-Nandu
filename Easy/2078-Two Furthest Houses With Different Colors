class Solution {
public:
    int maxDistance(vector<int>& colors) {
        int n = colors.size();
        int ans = 0;

        // Check pairs starting from the first house (scan right to left)
        for (int j = n - 1; j > 0; j--) {
            if (colors[0] != colors[j]) {
                ans = max(ans, j);  // distance = j - 0 = j
                //break;              // first hit from the right is the farthest
            }
        }

        // Check pairs ending at the last house (scan left to right)
        for (int i = 0; i < n - 1; i++) {
            if (colors[i] != colors[n - 1]) {
                ans = max(ans, n - 1 - i);  // distance = (n-1) - i
                //break;                       // first hit from the left is the farthest
            }
        }

        return ans;
    }
};
